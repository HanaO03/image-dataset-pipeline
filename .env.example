# Copy to .env before running:  cp .env.example .env
# .env is gitignored; never commit real credentials.

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=imagedb
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me-locally

# --- what to collect ---------------------------------------------------------
SOURCE_CLASSES=["cat","dog","bird"]
# Enforced in both directions: classes are trimmed back to this number, and a
# class finishing below SOURCE_MIN_PER_CLASS marks the run 'partial'.
SOURCE_TARGET_PER_CLASS=60
SOURCE_MIN_PER_CLASS=40
# Headroom for candidates lost to validation, licensing and dedup. Measured
# defect rate is ~3%, so 1.5 is generous; the surplus is trimmed, not shipped.
SOURCE_OVERFETCH_FACTOR=1.5
# Only licences permitting BOTH commercial use and modification.
# "all-cc" would also admit NC/ND images, which are not safely usable as
# training data for a commercial model. See src/config.py for the reasoning.
SOURCE_OPENVERSE_LICENSE_TYPE=commercial,modification

# --- licence policy ----------------------------------------------------------
# Rejected at the normalise stage, for EVERY source. The Openverse filter above
# only covers Openverse; Commons is scraped and has no filter to set, so this is
# what makes "commercially usable" true of the whole dataset rather than of one
# source. Empty it for a research dataset that will never ship.
LICENSE_FORBIDDEN_ELEMENTS=["NC","ND"]

# --- politeness --------------------------------------------------------------
# Minimum seconds between requests to the SAME host; hosts proceed in parallel.
HTTP_MIN_DELAY_SECONDS=0.5
# Per-host overrides. upload.wikimedia.org answers 429 (Retry-After: 11) at the
# default rate; 1.5s provoked none.
HTTP_MIN_DELAY_BY_HOST={"upload.wikimedia.org": 1.5}
HTTP_USER_AGENT=AICare-DatasetPipeline/1.0 (take-home evaluation; contact: hanaaabukhadija@gmail.com)

# --- tuning ------------------------------------------------------------------
DEDUPE_MAX_HAMMING_DISTANCE=5
SPLIT_TRAIN_PERCENT=80
LOG_JSON=true
LOG_LEVEL=INFO
